<body>
    <%layout("layouts/boilerplate") %>
        <div class="row mt-3">
            <div class="col-3 offset-4">
                <h3>Book Your Stay</h3>
                <br><br>
                <form action="/listings/booking/<%= listing._id %>" method="post" class="needs-validation" novalidate  >
                    <div class="mb-3">
                        <label for="checkIn" class="form-label">CheckIn</label>
                        <input type="date" name="checkIn" class="form-control" required>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">please enter valid title</div>

                    </div>
                    <div class="mb-3">
                        <label for="checkOut" class="form-label">CheckOut</label>
                        <input type="date" name="checkOut" class="form-control"
                        required>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">please enter valid description </div>

                        <div class="mb-3 ">
                            <label for="guests" class="form-label">Guests</label>
                            <input type="number" name="guests" class="form-control" required>

                            <div class="invalid-feedback">please enter valid guests </div>
                            
                        </div>

                    </div>

                    

                    
                    
                    <button type="submit" class="btn btn-dark add-btn mt-3">Confirm Booking</button>
                </form>
            </div>
        </div>
</body>